<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PadMaster.Controls</AssemblyName>
    <RootNamespace>PadMaster.Controls</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.3.0-beta</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\PadMaster.Bridge\Log.cs" />
    <Compile Include="..\PadMaster.Bridge\Cli.cs" />
    <Compile Include="..\PadMaster.Bridge\Settings.cs" />
    <ProjectReference Include="..\PadMaster.Core\PadMaster.Core.csproj" />
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>$(LaunchBoxDir)\Core\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
